"use client";

// Composer shell. Owns the step machine and mounts as a full-screen overlay (like a pushed route in Flutter),
// so the app shell's rail/tab bar stay out of the way. Desktop gets the studio layout in the next batch;
// until then it shows this same flow in a centred column.
import { useCallback, useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { useAuth } from "@/lib/auth/auth-context";
import type { ContentKind } from "@/lib/create/types";
import { useComposer } from "@/lib/create/use-composer";
import { EditorStep } from "./editor-step";
import { PickStep } from "./pick-step";
import { PublishStep } from "./publish-step";
import { ExitSheet, Toast } from "./ui";

type Step = "pick" | "edit" | "publish";

export function Composer({ initialKind }: { initialKind: ContentKind }) {
  const router = useRouter();
  const { status } = useAuth();
  const c = useComposer(initialKind);
  const [step, setStep] = useState<Step>("pick");
  const [exiting, setExiting] = useState(false);

  const leave = useCallback(() => {
    if (window.history.length > 1) router.back();
    else router.replace("/");
  }, [router]);

  useEffect(() => {
    if (status === "guest") router.replace("/login");
  }, [status, router]);

  useEffect(() => {
    const prev = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    return () => {
      document.body.style.overflow = prev;
    };
  }, []);

  const media = c.draft.media;
  const videoOnly = media.length > 0 && media.every((m) => m.type === "video");

  const close = useCallback(() => {
    if (c.busy) return;
    if (media.length === 0) leave();
    else setExiting(true);
  }, [c.busy, leave, media.length]);

  const fromPick = () => {
    if (!media.length) return;
    // Multi-photo posts slide by default (same as the Flutter editor's initState).
    if (!videoOnly && media.length > 1 && c.draft.kind !== "listing" && !c.draft.slideshow.enabled) {
      c.update({ slideshow: { ...c.draft.slideshow, enabled: true } });
    }
    setStep(videoOnly ? "publish" : "edit");
  };

  if (status !== "authed") return <div className="fixed inset-0 z-[60] bg-bg md:absolute md:inset-y-0 md:left-[76px] md:right-0" />;

  return (
    <div className="fixed inset-0 z-[60] flex justify-center bg-bg md:relative md:inset-auto md:z-auto md:min-h-dvh md:flex-1 md:justify-center md:bg-transparent">
      <div
        className="relative flex h-full w-full max-w-[520px] flex-col md:min-h-dvh md:h-auto md:max-w-[720px] md:border-x md:border-white/8 md:bg-bg"
        style={{ paddingTop: "env(safe-area-inset-top)", paddingBottom: "env(safe-area-inset-bottom)" }}
      >
        {step === "pick" && <PickStep c={c} onNext={fromPick} onClose={close} />}
        {step === "edit" && <EditorStep c={c} onBack={() => setStep("pick")} onNext={() => setStep("publish")} />}
        {step === "publish" && <PublishStep c={c} onBack={() => setStep(videoOnly ? "pick" : "edit")} onDone={leave} />}
      </div>

      {exiting && (
        <ExitSheet
          onKeep={() => setExiting(false)}
          onDiscard={leave}
          onSave={async () => {
            if (await c.saveDraft()) leave();
            else setExiting(false);
          }}
        />
      )}
      <Toast toast={c.toast} />
    </div>
  );
}
