/* eslint-disable @next/next/no-img-element */
"use client";

import Link from "next/link";
import { useState } from "react";
import { Avatar } from "@/components/ui/avatar";
import { Icon } from "@/components/ui/icon";
import { MULTI_MIN, MultiBadge } from "@/components/ui/multi-badge";
import type { SharedPost } from "@/lib/api/messaging";

function clock(sec: number) {
  const s = Math.max(0, Math.round(sec));
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
}

function Unavailable() {
  return (
    <div className="mb-1 flex w-56 flex-col items-center gap-2 rounded-[22px] border border-line bg-card px-5 py-8 text-center">
      <span className="grid size-11 place-items-center rounded-full bg-white/8 text-white/70">
        <Icon name="eyeClosed" className="size-5" />
      </span>
      <p className="text-secondary font-semibold text-fg">Post unavailable</p>
      <p className="text-supporting text-muted">It may have been deleted or made private.</p>
    </div>
  );
}

function Card({ post }: { post: SharedPost }) {
  const [loaded, setLoaded] = useState(false);
  const [failed, setFailed] = useState(false);

  const href = post.type === "listing" ? `/listing/${post.id}` : `/p/${post.id}`;
  const video = post.is_video;
  const multi = !video && post.image_count >= MULTI_MIN;
  const showImage = !!post.image && !failed;
  const hasBottom = video || !!post.caption || !!post.price;

  return (
    <div
      className={`group/card relative mb-1 w-56 overflow-hidden rounded-[22px] bg-card shadow-[0_12px_32px_rgba(0,0,0,0.5)] ring-1 ring-white/10 transition-shadow duration-300 hover:shadow-[0_18px_44px_rgba(0,0,0,0.65)] ${
        video ? "aspect-[9/15]" : "aspect-[4/5]"
      }`}
    >
      {/* Media */}
      {showImage ? (
        <>
          {!loaded && <span className="absolute inset-0 animate-pulse bg-white/6" />}
          <img
            ref={(el) => {
              if (el?.complete && el.naturalWidth > 0) setLoaded(true);
            }}
            src={post.image ?? undefined}
            alt=""
            loading="lazy"
            decoding="async"
            draggable={false}
            onLoad={() => setLoaded(true)}
            onError={() => setFailed(true)}
            className={`absolute inset-0 size-full object-cover transition-[opacity,transform] duration-500 ease-out group-hover/card:scale-[1.04] ${
              loaded ? "opacity-100" : "opacity-0"
            }`}
          />
        </>
      ) : (
        <div
          className="absolute inset-0 grid place-items-center"
          style={{ background: "linear-gradient(160deg,#1d1d24 0%,#0b0b0f 100%)" }}
        >
          <Icon name={video ? "videocamera" : "gallery"} className="size-10 text-white/25" />
        </div>
      )}

      {/* Whole-card tap target (author link and chips sit above it) */}
      <Link
        href={href}
        aria-label={post.caption ? `Open post: ${post.caption}` : "Open post"}
        className="absolute inset-0 z-[1] outline-offset-[-3px] focus-visible:outline-2 focus-visible:outline-white"
      />

      {/* Top scrim + author row */}
      <span
        className="pointer-events-none absolute inset-x-0 top-0 z-[2] h-24"
        style={{ background: "linear-gradient(to bottom, rgba(0,0,0,0.62), rgba(0,0,0,0))" }}
      />
      {post.author && (
        <Link
          href={`/u/${post.author}`}
          className="absolute left-2.5 top-2.5 z-[3] flex max-w-[calc(100%-56px)] items-center gap-2 transition-opacity hover:opacity-80"
        >
          <Avatar url={post.author_avatar} name={post.author_name ?? post.author} size={28} className="ring-2 ring-white/80" />
          <span className="text-shadow truncate text-[13px] font-bold leading-none text-white">{post.author}</span>
          {post.author_verified && <Icon name="verifiedCheck" filled className="size-3.5 text-sky-400" />}
        </Link>
      )}

      {/* Top-right: copy badge for multi-image posts */}
      {multi && <MultiBadge className="right-2.5 top-2.5" />}

      {/* Centre play for video / reels */}
      {video && (
        <span className="pointer-events-none absolute inset-0 z-[2] grid place-items-center">
          <span className="grid size-12 place-items-center rounded-full bg-black/40 text-white ring-1 ring-white/25 backdrop-blur-md transition-transform duration-200 group-hover/card:scale-110">
            <Icon name="play" filled className="size-5 translate-x-px" />
          </span>
        </span>
      )}

      {/* Bottom scrim + price, clapperboard chip, caption */}
      {hasBottom && (
        <>
          <span
            className="pointer-events-none absolute inset-x-0 bottom-0 z-[2] h-32"
            style={{ background: "linear-gradient(to top, rgba(0,0,0,0.78), rgba(0,0,0,0))" }}
          />
          <div className="pointer-events-none absolute inset-x-0 bottom-0 z-[2] flex flex-col gap-2 p-3">
            {post.price && (
              <span className="self-start rounded-full bg-white px-2.5 py-1 text-supporting font-extrabold text-black">
                ₦{post.price}
              </span>
            )}
            {(video || post.caption) && (
              <div className="flex items-end gap-2">
                {video && (
                  <span className="inline-flex h-7 shrink-0 items-center gap-1.5 rounded-lg bg-white px-2 text-black shadow-[0_2px_10px_rgba(0,0,0,0.35)]">
                    <Icon name="clapperboard" filled className="size-4" />
                    {post.duration !== null && (
                      <span className="text-[11px] font-bold tabular-nums leading-none">{clock(post.duration)}</span>
                    )}
                  </span>
                )}
                {post.caption && (
                  <p className="text-shadow line-clamp-2 min-w-0 text-[12.5px] font-semibold leading-snug text-white/95">
                    {post.caption}
                  </p>
                )}
              </div>
            )}
          </div>
        </>
      )}
    </div>
  );
}

export function SharedPostCard({ post }: { post: SharedPost }) {
  return post.unavailable ? <Unavailable /> : <Card post={post} />;
}
